# Network
MS_REGISTER_PROXY=
MS_REGISTER_TIMEOUT=30
MS_REGISTER_COUNTRY=US
MS_REGISTER_MARKET=
MS_REGISTER_TIMEZONE=480
MS_REGISTER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36 Edg/147.0.0.0"

# Captcha.run 自动验证码识别
CAPTCHA_RUN_KEY=
CAPTCHA_RUN_BASE_URL=https://api.captcha-run.com/v2/tasks
CAPTCHA_RUN_POLL_INTERVAL=3
CAPTCHA_RUN_MAX_WAIT=60

# Output
MS_REGISTER_OUTPUT=accounts.txt
